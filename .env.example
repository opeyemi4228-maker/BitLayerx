# Admin. Both are required or /admin refuses every login.
# Generate the secret with:  openssl rand -hex 32
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Forward every enquiry somewhere durable. Strongly recommended on Vercel,
# where the file system is read only and the local lead store cannot persist.
LEAD_WEBHOOK_URL=

# Measurement. The dashboard shows which of these are live.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_HOTJAR_ID=

# Search Console and Bing verification.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=

# Raises the GitHub API rate limit for the live work index.
GITHUB_TOKEN=
